# ── Weave Configuration ────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values before running docker compose.
# See README.md for a full explanation of each variable.

# ── WebRTC ────────────────────────────────────────────────────────────────────
# Your server's public hostname or IP address.
# mediasoup advertises this to clients as the WebRTC ICE endpoint.
# Use a domain (e.g. DuckDNS) if your public IP is dynamic.
ANNOUNCED_IP=your-domain-or-public-ip-here

# Optional: your server's LAN IP, advertised as a 2nd ICE candidate for
# same-network clients. Leave blank if you don't need LAN-direct connections.
LOCAL_ANNOUNCED_IP=

# UDP port range for mediasoup WebRTC media.
# You MUST forward these ports (UDP) on your router to this server's LAN IP.
RTC_MIN_PORT=10000
RTC_MAX_PORT=10100

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Host port that maps to Weave's internal web server port (3000).
HTTP_PORT=3000

# ── Cloudflare Tunnel (optional) ──────────────────────────────────────────────
# Only required if you use docker-compose.tunnel.yml.
# Get the token from: Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Configure
WEAVE_TUNNEL_TOKEN=
