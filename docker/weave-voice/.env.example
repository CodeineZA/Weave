# Voice Chat Room Configuration
# This file is read by docker-compose and the Node.js server

# Server port (internal to container)
PORT=3000

# Optional: TURN server configuration for NAT traversal
# Uncomment and fill in if you have a TURN server (e.g., Coturn)
# TURN_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=username
# TURN_CREDENTIAL=credential
