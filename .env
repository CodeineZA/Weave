# .env - Keep this file private and do not commit it
SERVER_PASSWORD=qwerty123
PORT=3000

# === TURN CONFIG (Critical for your setup) ===
TURN_URL=turn:staticauth.openrelay.metered.ca:443
TURN_USERNAME=openrelayproject
TURN_CREDENTIAL=openrelayprojectsecret

# Optional: Add TCP fallback (helps with strict firewalls)
TURN_URL2=turn:staticauth.openrelay.metered.ca:443?transport=tcp